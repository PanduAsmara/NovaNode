# ============================================================
# NovaNode — Environment Variables (root)
# Copy to .env and adjust. Created by PanduAsmara.
# ============================================================

NODE_ENV=development

# --- Database (PostgreSQL) ---
POSTGRES_USER=novanode
POSTGRES_PASSWORD=novanode_secret
POSTGRES_DB=novanode
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://novanode:novanode_secret@localhost:5432/novanode?schema=public

# --- Redis (Queue / Cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ---
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Credentials encryption (SSH secrets, Pterodactyl API key) ---
CREDENTIAL_SECRET=change_me_credential_secret

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
