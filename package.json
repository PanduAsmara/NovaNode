{
  "name": "novanode",
  "version": "0.1.0",
  "private": true,
  "description": "Professional Infrastructure Management Platform for Pterodactyl Ecosystems",
  "author": "PanduAsmara",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @novanode/database generate",
    "db:migrate": "pnpm --filter @novanode/database migrate",
    "db:push": "pnpm --filter @novanode/database push",
    "db:seed": "pnpm --filter @novanode/database seed",
    "db:studio": "pnpm --filter @novanode/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp"]
  }
}
